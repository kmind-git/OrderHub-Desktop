# OrderHub update service (Hono + SQLite)
# Use 0.0.0.0 to expose the service on a trusted LAN.
ORDERHUB_UPDATER_HOST=127.0.0.1
ORDERHUB_UPDATER_PORT=8787
ORDERHUB_UPDATER_DB=../../test-artifacts/runtime/updater.sqlite3
ORDERHUB_UPDATER_ARTIFACT_DIR=../../test-artifacts/artifacts
ORDERHUB_UPDATER_PUBLIC_BASE_URL=http://127.0.0.1:8787/artifacts
ORDERHUB_UPDATER_ADMIN_TOKEN=replace-with-a-long-random-release-token
ORDERHUB_UPDATER_ADMIN_ACTOR=release-cli
ORDERHUB_UPDATER_APP_ID=com.orderhub.desktop
ORDERHUB_UPDATER_SERVE_ARTIFACTS=1
ORDERHUB_UPDATER_VERIFY_ARTIFACT_URL=0
# Set to 1 to allow a non-loopback plain-HTTP PUBLIC_BASE_URL. Only trusted LAN.
ORDERHUB_UPDATER_ALLOW_INSECURE_ARTIFACT_URL=1
# Required when VERIFY_ARTIFACT_URL=1: Base64 minisign public key used to verify
# the final artifact bytes and the signed version before publishing.
# ORDERHUB_UPDATER_SIGNING_PUBLIC_KEY=RW...
ORDERHUB_UPDATER_EVENT_RETENTION_DAYS=30
ORDERHUB_UPDATER_POLICY_VALID_SECONDS=86400
ORDERHUB_UPDATER_SUPPORT_URL=
ORDERHUB_UPDATER_TRUST_PROXY=0
